# ── App ──────────────────────────────────────────────────────────
PROJECT_NAME="RH AI memory and EdAgent"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
# true → заглушка вместо Ollama (экономит RAM при разработке); false в проде
MOCK_LLM=false

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edagent
POSTGRES_USER=edagent
POSTGRES_PASSWORD=edagent_secret

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Celery ────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Chroma ────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── Ollama (локальный LLM) ────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b          # llama3.2:3b если мало VRAM

# ── GigaChat (резервный облачный LLM, если Ollama недоступна) ──────
GIGACHAT_ENABLED=false
GIGACHAT_CREDENTIALS=             # Authorization key (base64) из личного кабинета GigaChat
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_VERIFY_SSL_CERTS=false

# ── HuggingFace ───────────────────────────────────────────────────
HF_TOKEN=hf_...
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# ── HeadHunter API ────────────────────────────────────────────────
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_ACCESS_TOKEN=
HH_AREA_ID=3    # 3=Екатеринбург 1=Москва 2=Санкт-Петербург

# ── Superjob API ──────────────────────────────────────────────────
SUPERJOB_CLIENT_ID=
SUPERJOB_SECRET_KEY=

# ── LinkedIn API ──────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# ── SendGrid ─────────────────────────────────────────────────────
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@yourdomain.ru

# ── IMAP (входящие письма) ────────────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ── Spark-Interfax ────────────────────────────────────────────────
SPARK_API_KEY=

# ── Sentry ───────────────────────────────────────────────────────
SENTRY_DSN=

ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
