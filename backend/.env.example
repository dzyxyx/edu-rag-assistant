# ── App ──────────────────────────────────────────────────────────
PROJECT_NAME="RH AI memory and EdAgent"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edagent
POSTGRES_USER=edagent
POSTGRES_PASSWORD=edagent_secret

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Celery ────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Chroma ────────────────────────────────────────────────────────
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ── Ollama (локальный LLM) ────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── HuggingFace ───────────────────────────────────────────────────
HF_TOKEN=hf_...

# ── HeadHunter API ────────────────────────────────────────────────
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_ACCESS_TOKEN=

# ── Superjob API ──────────────────────────────────────────────────
SUPERJOB_CLIENT_ID=
SUPERJOB_SECRET_KEY=

# ── LinkedIn API ──────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# ── SendGrid ─────────────────────────────────────────────────────
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@yourdomain.ru

# ── IMAP (входящие письма) ────────────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ── Spark-Interfax ────────────────────────────────────────────────
SPARK_API_KEY=

# ── Sentry ───────────────────────────────────────────────────────
SENTRY_DSN=
