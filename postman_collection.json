                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/outreach/events?campaign_id={{campaign_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "outreach",
